# HomeBoard Server Configuration
PORT=8080
HOST=0.0.0.0
DB_PATH=./homeboard.db
APP_ENV=development
BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Security and Rate Limiting
TOKEN_TTL_MINUTES=10
MAX_ITEMS_PER_BOARD=200
MAX_DEVICES_PER_BOARD=10
RATE_LIMIT_REDEEM_PER_MINUTE=20
RATE_LIMIT_TOKEN_GEN_PER_MINUTE=10

# Optional Amazon Bedrock Natural Language Processing (Phase 7)
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-haiku-4-5-20251001-v1:0
